"# Auto detect text files and perform LF normalization" 
"* text=auto" 
"" 
"# Source code files - force LF" 
"*.js text eol=lf" 
"*.ts text eol=lf" 
"*.jsx text eol=lf" 
"*.tsx text eol=lf" 
"*.html text eol=lf" 
"*.css text eol=lf" 
"*.json text eol=lf" 
"*.md text eol=lf" 
"*.yml text eol=lf" 
"*.yaml text eol=lf" 
"*.toml text eol=lf" 
"*.py text eol=lf" 
"*.svg text eol=lf" 
"" 
"# Binary files" 
"*.png binary" 
"*.jpg binary" 
"*.jpeg binary" 
"*.gif binary" 
"*.ico binary" 
"*.pyc binary" 
"*.db binary" 
